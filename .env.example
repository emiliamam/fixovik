# PostgreSQL
POSTGRES_DB=fixovik
POSTGRES_USER=fixovik
POSTGRES_PASSWORD=change-this-postgres-password

# Redis internal password. Redis is not published outside the Docker network.
REDIS_PASSWORD=change-this-redis-password

# Default password for demo accounts created by Init.java.
# Change it before production deployment.
APP_DEFAULT_PASSWORD=change-this-default-user-password

# Spring Security remember-me signing key.
# Generate a long random value before production deployment.
APP_REMEMBER_ME_KEY=change-this-to-a-long-random-secret
